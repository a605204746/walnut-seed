# ==================================================================
# Docker 编排变量插值模板：复制为 docker/.env 后按需修改
# docker compose 会自动读取编排文件同目录的 .env 做变量插值
# （注意：这是 compose 的插值文件，与后端 walnut-backend-python/env/ 无关）。
# JWT_SECRET_KEY 为强制项（编排内以 ${VAR:?...} 引用，未设置/留空则启动直接失败）；
# 其余变量未设置时由编排内 ${VAR:-默认值} 兜底，开箱即用。
# ==================================================================

# MySQL root 密码（mysql 服务与两个后端的数据库密码共用，一处改处处生效）
DB_PASSWORD=walnut123

# Python 后端业务库名（中间件首次初始化建库 + Python backend 连接共用）。
# Java 后端固定使用 walnut_seed_java（JDBC URL 自动建库），不受此变量影响
DB_NAME=walnut_seed_python

# 后端服务端口（backend 监听 + nginx upstream 共用；前端容器对外仍是 8010）
BACKEND_PORT=8011

# JWT 签名密钥：必填！两套全栈编排均以 ${JWT_SECRET_KEY:?...} 强制引用
# （Python 编排注入 SECRET_KEY，Java 编排注入 SA_TOKEN_JWT_SECRET_KEY），
# 未设置或留空时 docker compose up 会直接报错退出，不会静默使用任何默认密钥。
# 要求 ≥32 字节，用下面的命令生成后粘贴：
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=52367efc2c3b579bbcb01702b7560a4f0f978c9c073fc051d9e8c9774ca864a3

# SeaweedFS S3 凭据（当前镜像版本 S3 网关不校验身份，保留以备升级后启用）
OSS_ACCESS_KEY=walnut
OSS_SECRET_KEY=walnut123
