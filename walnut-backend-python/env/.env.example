# ==================================================================
# 环境配置模板：复制为 .env.dev 或 .env.prod 后按需修改。
# 只写「必填项」和「有意覆盖默认值」的项，
# 其余配置项一律使用 app/config/setting.py 中的代码默认值（唯一事实源）。
# ==================================================================

ENVIRONMENT=dev

# ==================== 数据库 ====================
# 连接 Docker 中间件编排（docker/docker-compose.middleware.yml）：
# 宿主机映射端口 MySQL 3307 / Redis 6380（非默认端口，避免与本机自装服务冲突）
DATABASE_PORT=3307
DATABASE_PASSWORD=your_database_password
# 代码默认 True（打印参数填充后的完整 SQL），日常关掉；排障可改 debug
DATABASE_ECHO=False
# dev 启动时自动执行 Alembic 迁移（代码默认 False；prod 由 entrypoint 显式执行）
DATABASE_AUTO_MIGRATE=True

# ==================== Redis ====================
REDIS_PORT=6380
# Redis 键根前缀（与 Java 后端 walnut-seed-java 区分，共用同一 Redis 实例时避免互相串键）
REDIS_KEY_PREFIX=walnut-seed-python

# ==================== 登录认证 ====================
# JWT 签名密钥（≥32 字节），生产环境务必替换为随机值
# （uv run python scripts/gen_secret_key.py 生成）
SECRET_KEY=your_jwt_secret_key_of_at_least_32_bytes

# 可信代理 IP 列表（逗号分隔）：仅当请求直连地址在此列表中时，
# 才解析 X-Forwarded-For / X-Real-IP 等代理头，否则一律取对端地址（防 IP 伪造）。
# 反向代理（nginx）与后端同机部署示例：TRUSTED_PROXY_IPS=["127.0.0.1","::1"]
# TRUSTED_PROXY_IPS=["127.0.0.1"]

# 导入用户初始密码（sys_config 中 sys.user.initPassword 缺失时的回退值），
# 必须满足复杂度规则：大小写字母+数字+特殊字符，长度 ≥8
# USER_IMPORT_INIT_PASSWORD=Walnut@123

# 雪花算法机器位（0-1023）：多 worker/多副本部署必须为每个实例显式配置不同值
# SNOWFLAKE_WORKER_ID=1

# ==================== 接口加解密 ====================
# RSA 密钥对留空则启动时自动停用接口加解密（降级为明文）；
# 生产环境用 scripts/gen_rsa_keys.py 生成两对密钥并按前后端配对说明配置。
# API_DECRYPT_PUBLIC_KEY=
# API_DECRYPT_PRIVATE_KEY=
