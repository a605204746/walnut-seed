# ==================================================================
# 本地开发环境配置：只写「必填项」和「有意覆盖默认值」的项，
# 其余配置项一律使用 app/config/setting.py 中的代码默认值（唯一事实源）。
# Docker 部署不读本文件（镜像不含 env/，配置由 compose 环境变量注入）。
# ==================================================================

ENVIRONMENT=dev

# ==================== 数据库 ====================
# 连接 Docker 中间件编排（docker/docker-compose.middleware.yml）：
# 宿主机映射端口 MySQL 3307 / Redis 6380（非默认端口，避免与本机自装服务冲突）
DATABASE_PORT=3307
DATABASE_PASSWORD=walnut123
# 代码默认 True（打印参数填充后的完整 SQL），日常关掉；排障可改 debug
DATABASE_ECHO=False
# dev 启动时自动执行 Alembic 迁移（代码默认 False；prod 由 entrypoint 显式执行）
DATABASE_AUTO_MIGRATE=True

# ==================== Redis ====================
REDIS_PORT=6380
# Redis 键根前缀（与 Java 后端 walnut-seed-java 区分，共用同一 Redis 实例时避免互相串键）
REDIS_KEY_PREFIX=walnut-seed-python

# ==================== 登录认证 ====================
# JWT 签名密钥（≥32 字节）。dev 用随机生成值即可（已入库，无真实敏感性）；
# 生产环境必须注入环境变量（compose 以 :? 强制要求，漏配直接启动失败）。
SECRET_KEY=ff1b17637fa43aabaf150d43adb021fd9ec6d11809c94c4e5c7dbb80b380a0e3

# ==================== 接口加解密（RSA 密钥对） ====================
# 仅开发环境使用的密钥对（与前端 apps/web-antd/.env.development 配对）：
#   API_DECRYPT_PRIVATE_KEY 解前端请求 —— 对应前端 VITE_GLOB_RSA_PUBLIC_KEY
#   API_DECRYPT_PUBLIC_KEY  加后端响应 —— 对应前端 VITE_GLOB_RSA_PRIVATE_KEY
# 生产环境必须整体替换为自己生成的密钥对（scripts/gen_rsa_keys.py），
# 两对密钥任一缺失时接口加解密中间件自动停用（不会静默使用默认密钥）。
API_DECRYPT_PUBLIC_KEY=MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQCzWeB2rv0CLeABVtm9K7Ak/uOCSzeSeVYNLzaIDM5Nb84NQ22fYjSFLDnQVZCfBGFKAF5Qhy/yIziDKfewdA48+MzHm/ln8gCRiPane78G8ja4wDTx1atmkGUTgrInvUasjKFKOA2DK/ejqg4bYPiGKdarHpNoaDFd7NntkgmyiwIDAQAB
API_DECRYPT_PRIVATE_
